# ============================================================
# DESKA Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# MongoDB Atlas Setup:
#   1. Go to https://cloud.mongodb.com → Create a free cluster
#   2. Click "Connect" → "Drivers" → copy the connection string
#   3. Replace <db_username>, <db_password>, and <db_cluster> below
#   Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/deska?retryWrites=true&w=majority
#
# For local development, leave MONGODB_URI empty (defaults to localhost).
# ============================================================

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ---
# Production (Atlas):
#   MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<db_cluster>.mongodb.net/deska?retryWrites=true&w=majority
# Local (default):
#   MONGODB_URI=mongodb://localhost:27017/deska
MONGODB_URI=

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-byte-hex-string
JWT_EXPIRES_IN=7d

# --- AI Providers ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_API_KEY=your-gemini-api-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
