# ============================================================
# DESKA Frontend — Environment Variables
# ============================================================
# Copy to .env or .env.production and fill in your values.
#
# Development:
#   Leave VITE_API_URL unset. Vite dev server proxies /api to
#   http://localhost:4000 (see vite.config.js).
#
# Production:
#   Set VITE_API_URL to your deployed backend URL, then run:
#     npm run build
#   The built files go to dist/ — serve them with any static host.
# ============================================================

VITE_API_URL=https://your-deployed-backend.com/api
